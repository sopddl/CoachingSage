# Python (Spike scripts éventuels)
__pycache__/
*.pyc
.venv/
venv/

# XcodeGen — le project.yml est versionné, le .xcodeproj généré NE l'est PAS (source of truth = project.yml)
CoachingSage.xcodeproj/
