# Xcode
.DS_Store
build/
*.xcuserstate
xcuserdata/
*.xcscmblueprint

# Secrets — JAMAIS versionnés
Config-Debug.xcconfig
Config-Staging.xcconfig
Config-Release.xcconfig
.env
**/.env
**/.env.local
**/.env.*.local
scripts/.service_role_key*
scripts/migration.log

# SPM
.build/
Packages/
*.swiftpm/xcode/*.xcscheme
.swiftpm/xcode/package.xcworkspace/

# CocoaPods (non utilisé mais par sécurité)
Pods/

# Supabase CLI
supabase/.temp/

# Claude Code local settings (settings.local.json, lock files…)
# mais on garde versionnés les agents partageables (.claude/agents/).
# Note : on ignore le CONTENU (.claude/*) et pas le dossier (.claude/), sinon Git
# ne descend pas dedans et l'exception !.claude/agents/ est silencieusement ignorée.
.claude/*
!.claude/agents/

# Snapshot testing — garder __Snapshots__/ versionné, ignorer les diffs d'échec
**/FailureDiffs/
*.xcresult

# Python (Spike scripts éventuels)
__pycache__/
*.pyc
.venv/
venv/

# XcodeGen : project.yml sert UNIQUEMENT au bootstrap initial.
# Le .xcodeproj EST versionné (cohérent avec GardenSage/TailorSage, éditable via Xcode).
