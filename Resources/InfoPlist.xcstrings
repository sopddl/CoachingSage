    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoachingSage uses Apple Health to pre-fill your sport profile (sex, age, weight, height) and to estimate your level and activity frequency from recent workouts. You can also enter this info manually at any time."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoachingSage utilise Apple Santé pour pré-remplir votre profil sportif (sexe, âge, poids, taille) et estimer votre niveau et fréquence d'activité depuis vos séances récentes. Vous pouvez aussi saisir ces informations manuellement à tout moment."
          }
        }
      }
    }
  },
  "version" : "1.0"
}