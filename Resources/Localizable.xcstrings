      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bike-to-run transition, done in the bike park area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transición bici → carrera a pie, en la zona de boxes de bicis."
          }
        },
