    "glossary.1rm.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your 1RM is the heaviest load you can lift once with proper form. %1RM expresses the working load as a fraction (e.g. 80% 1RM ≈ heavy strength work, 65% ≈ hypertrophy)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu 1RM es la carga más pesada que puedes levantar 1 sola vez con buena técnica. El %1RM expresa la carga de trabajo (p. ej. 80% 1RM ≈ fuerza pesada, 65% ≈ hipertrofia)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton 1RM est la charge la plus lourde que tu peux soulever 1 seule fois en bonne forme. %1RM exprime la charge de travail (ex. 80% 1RM ≈ force lourde, 65% ≈ hypertrophie)."
          }
        }
      }
    },
    "glossary.1rm.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1RM — Percentage of one-rep max"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1RM — Porcentaje del 1RM"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1RM — Pourcentage du 1RM"
          }
        }
      }
    },
    "glossary.amrap.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A timed block where you do as many reps (or rounds of a circuit) as possible. Stop the clock, not the work, when you're done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bloque cronometrado en el que haces tantas reps (o vueltas de circuito) como puedas. Cuando se acaba el tiempo, paras — no antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bloc chronométré où tu fais autant de reps (ou de tours de circuit) que possible. Quand le temps est écoulé, tu t'arrêtes — pas avant."
          }
        }
      }
    },
    "glossary.amrap.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AMRAP — As Many Reps/Rounds As Possible"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AMRAP — El mayor número de reps/vueltas posible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AMRAP — Le plus de reps/tours possible"
          }
        }
      }
    },
    "glossary.band.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An elastic band (mini-band or loop) that adds resistance. Mostly used to activate a muscle or assist a movement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una goma elástica (mini-band o banda) que añade resistencia. Sirve sobre todo para activar un músculo o asistir un movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élastique (mini-band ou bande) qui ajoute de la résistance. Sert surtout à activer un muscle ou à assister un mouvement."
          }
        }
      }
    },
    "glossary.band.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Band — Resistance band"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Band — Goma de resistencia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Band — Élastique de résistance"
          }
        }
      }
    },
    "glossary.glutes.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The muscles of your buttocks (gluteus maximus, medius and minimus). You 'activate' them before training so they fire properly during squats, running or jumping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los músculos de las nalgas (glúteo mayor, medio y menor). Se «activan» antes del esfuerzo para que participen bien en el movimiento (sentadilla, carrera, salto)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les muscles des fesses (grand, moyen et petit fessier). On les « active » avant l'effort pour qu'ils participent bien au mouvement (squat, course, saut)."
          }
        }
      }
    },
    "glossary.glutes.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glutes — Gluteal muscles"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glúteos — Músculos glúteos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glutes — Muscles fessiers"
          }
        }
      }
    },
    "glossary.mobility.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working a joint's range of motion: moving it fully and with control to prepare the body before training (shoulders, hips…)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trabajo de amplitud de una articulación: moverla en todo su recorrido y con control para preparar el cuerpo antes del esfuerzo (hombros, caderas…)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le travail d'amplitude d'une articulation : la bouger en grand et en contrôle pour préparer le corps avant l'effort (épaules, hanches…)."
          }
        }
      }
    },
    "glossary.mobility.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobility — Joint range of motion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movilidad — Amplitud articular"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobilité — Amplitude articulaire"
          }
        }
      }
    },
    "glossary.recovery.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rest time between two efforts: you slow down or stop to let your body recover before the next set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de recuperación entre dos esfuerzos: bajas el ritmo o paras para dejar respirar al cuerpo antes de la siguiente serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps de récupération entre deux efforts : tu ralentis ou tu t'arrêtes pour laisser le corps souffler avant la série suivante."
          }
        }
      }
    },
    "glossary.recovery.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récup — Récupération"
          }
        }
      }
    },
    "glossary.bandpullapart.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull an elastic band apart in front of you, arms extended, until it touches your chest. Strengthens upper back and shoulders. Classic warmup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separar una goma elástica tensa delante de ti, con los brazos estirados, hasta que toque el pecho. Refuerza la parte alta de la espalda y los hombros. Calentamiento clásico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écarter une bande élastique tendue devant soi, bras tendus, jusqu'à ce qu'elle touche la poitrine. Renforce le haut du dos et les épaules. Échauffement classique."
          }
        }
      }
    },
    "glossary.bandpullapart.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Band pull apart"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Band pull apart"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écartement à l'élastique"
          }
        }
      }
    },
    "glossary.barrevide.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Olympic barbell with no plates (20 kg / 45 lb). Used as warmup to rehearse the movement before adding load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barra olímpica sin ningún disco (20 kg). Sirve de calentamiento para repetir el gesto antes de añadir carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre olympique sans aucun disque (20 kg). Sert d'échauffement pour répéter le geste avant d'ajouter les charges."
          }
        }
      }
    },
    "glossary.barrevide.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty bar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barra vacía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre vide"
          }
        }
      }
    },
    "glossary.cadence.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps per minute (running, target ~175-185 spm), pedal revolutions per minute (cycling, target ~85-95 rpm), or arm cycles per 25m (swimming). Higher cadence = lower impact per stride and smoother power."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasos por minuto (carrera, objetivo ~175-185 ppm), revoluciones de pedal por minuto (ciclismo, objetivo ~85-95 rpm), o ciclos de brazo por 25 m (natación). Cadencia alta = menos impacto por zancada y potencia más fluida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas par minute (course, cible ~175-185 ppm), tours de pédalier par minute (vélo, cible ~85-95 rpm), ou cycles de bras par 25m (natation). Cadence haute = moins d'impact par foulée et puissance plus fluide."
          }
        }
      }
    },
    "glossary.cadence.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadence — Stride/pedal/stroke rate"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadencia — Frecuencia de pasos/pedaleo/brazada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadence — Fréquence pas/pédales/bras"
          }
        }
      }
    },
    "glossary.cars.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow, controlled rotations of a joint (shoulder, hip, ankle) through its full range of motion. Used to mobilize and maintain joint flexibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotaciones lentas y controladas de una articulación (hombro, cadera, tobillo) en el máximo de su amplitud. Sirve para movilizar y preservar la flexibilidad articular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotations lentes et contrôlées d'une articulation (épaule, hanche, cheville) au maximum de son amplitude. Sert à mobiliser et préserver la souplesse articulaire."
          }
        }
      }
    },
    "glossary.cars.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CARs — Controlled Articular Rotations"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CARs — Rotaciones articulares controladas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CARs — Rotations articulaires contrôlées"
          }
        }
      }
    },
    "glossary.catcow.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On all fours, alternate hollow back (cow) and rounded back (cat). Mobilizes the spine, classic warmup in both strength and yoga."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A cuatro patas, alternar espalda arqueada (cow, vaca) y espalda redondeada (cat, gato). Moviliza la columna, calentamiento clásico tanto en fuerza como en yoga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quatre pattes, alterner dos creux (cow, vache) et dos rond (cat, chat). Mobilise la colonne, échauffement classique en strength comme en yoga."
          }
        }
      }
    },
    "glossary.catcow.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cat-cow"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cat-cow (gato-vaca)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cat-cow (chat-vache)"
          }
        }
      }
    },
    "glossary.css.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sustainable maximum swimming pace over ~30 min. Used to calibrate threshold sets. Often measured with a 400m + 200m time-trial test."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu velocidad máxima sostenible en nado continuo durante ~30 min. Sirve para calibrar las sesiones a umbral. A menudo se mide con un test cronometrado de 400 m + 200 m."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta vitesse maximale tenable en nage continue sur ~30 min. Sert à calibrer les séances au seuil. Souvent mesurée via un test 400m + 200m chronométré."
          }
        }
      }
    },
    "glossary.css.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CSS — Critical Swim Speed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CSS — Velocidad crítica de natación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CSS — Vitesse critique natation"
          }
        }
      }
    },
    "glossary.daniels.e.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversational, very aerobic pace from Jack Daniels' running formula. ~65-79% HRmax, all-day-able. The bulk of training volume sits here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo conversacional, muy aeróbico, procedente del método de Jack Daniels. ~65-79% de la FC máx., sostenible mucho tiempo. La mayor parte del volumen de entrenamiento se hace a este ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allure conversationnelle, très aérobie, issue de la méthode Jack Daniels. ~65-79% FC max, tenable longtemps. La majorité du volume d'entraînement se fait à cette allure."
          }
        }
      }
    },
    "glossary.daniels.e.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-E — Easy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-E — Resistencia fácil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-E — Endurance facile"
          }
        }
      }
    },
    "glossary.daniels.i.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard intervals (~95-100% HRmax) targeting VO2max. Reps of 3-5 min with equal recovery. Improves aerobic ceiling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalos duros (~95-100% de la FC máx.) que apuntan al VO2máx. Repeticiones de 3-5 min con recuperación equivalente. Mejora el techo aeróbico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalles durs (~95-100% FC max) ciblant la VO2max. Répétitions de 3-5 min avec récupération équivalente. Améliore le plafond aérobie."
          }
        }
      }
    },
    "glossary.daniels.i.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-I — Interval (VO2max)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-I — Intervalos VO2máx"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-I — Intervalles VO2max"
          }
        }
      }
    },
    "glossary.daniels.m.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pace you'd hold for a marathon (~80-89% HRmax). Comfortable-hard, sustainable for 1-3h depending on fitness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ritmo sostenible en un maratón (~80-89% de la FC máx.). Cómodo-sostenido, mantenible de 1 a 3 h según el nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'allure tenable sur un marathon (~80-89% FC max). Confortable-soutenue, tenable 1 à 3h selon le niveau."
          }
        }
      }
    },
    "glossary.daniels.m.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-M — Marathon pace"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-M — Ritmo de maratón"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-M — Allure marathon"
          }
        }
      }
    },
    "glossary.daniels.r.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short fast reps (~30s-2 min) at mile pace or faster, with full recovery. Improves running economy, speed, and neuromuscular power."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeticiones cortas (~30 s-2 min) a ritmo de 1500 m-1 milla o más rápido, con recuperación completa. Mejora la economía de carrera, la velocidad y la potencia neuromuscular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétitions courtes (~30s-2 min) à allure 1500m-1 mile ou plus rapide, avec récupération complète. Améliore l'économie de course, la vitesse, la puissance neuromusculaire."
          }
        }
      }
    },
    "glossary.daniels.r.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-R — Repetition"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-R — Repeticiones rápidas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-R — Répétitions rapides"
          }
        }
      }
    },
    "glossary.daniels.t.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lactate threshold pace, ~88-92% HRmax. Sustained ~20-40 min at this pace, in continuous blocks or 6-12 min cruise intervals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo a umbral láctico, ~88-92% de la FC máx. Sostenible ~20-40 min, ya sea en bloque continuo o en intervalos de 6-12 min (cruise intervals)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allure au seuil lactique, ~88-92% FC max. Tenable ~20-40 min, soit en bloc continu, soit en intervalles 6-12 min (cruise intervals)."
          }
        }
      }
    },
    "glossary.daniels.t.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-T — Threshold (tempo)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-T — Umbral (tempo)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daniels-T — Seuil (tempo)"
          }
        }
      }
    },
    "glossary.dislocation.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass an elastic band over your head then behind your back, arms straight, and return. Shoulder mobility exercise. No actual dislocation despite the name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar una goma elástica por encima de la cabeza y luego por detrás de la espalda, con los brazos estirados, y volver. Ejercicio de movilidad de hombros. No hay ninguna luxación real a pesar del nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer une bande élastique au-dessus de la tête puis derrière le dos, bras tendus, et revenir. Exercice de mobilité des épaules. Pas de luxation réelle malgré le nom."
          }
        }
      }
    },
    "glossary.dislocation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoulder dislocation (band)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoulder dislocation (goma)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoulder dislocation (élastique)"
          }
        }
      }
    },
    "glossary.drill.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercise that isolates ONE technical aspect of a sport movement. Not a 'real' set — perform slowly to feel and correct a specific phase. Example in swimming: 'catch-up drill' = one arm extended forward waits until the other arm completes its full stroke and touches it, then the cycle restarts. Isolates glide and coordination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicio que aísla UN aspecto técnico de un gesto deportivo. No es una serie 'de verdad' — se hace lento para sentir y corregir una fase concreta. Ejemplo en natación: drill de 'rattrapé' = un brazo estirado delante espera a que el otro brazo complete el ciclo entero y venga a tocarlo, y entonces este último arranca de nuevo. Aísla el deslizamiento y la coordinación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercice qui isole UN aspect technique d'un geste sportif. Pas une 'vraie' série — on fait lentement pour sentir et corriger une phase précise. Exemple en natation : drill 'rattrapé' = un bras tendu devant attend que l'autre bras fasse le cycle complet et vienne le toucher, puis ce dernier redémarre. Isole la glisse et la coordination."
          }
        }
      }
    },
    "glossary.drill.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drill — Technique isolation exercise"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Drill (educativo) — Ejercicio técnico de aislamiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drill (éducatif) — Exercice technique d'isolation"
          }
        }
      }
    },
    "glossary.emom.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the start of each minute, complete the prescribed work (e.g. 5 thrusters). The remaining time in the minute is your rest. Repeat for N minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al inicio de cada minuto haces el trabajo prescrito (p. ej. 5 thrusters). El resto del minuto es tu recuperación. Encadenas N minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au début de chaque minute, tu fais le travail prescrit (ex. 5 thrusters). Le reste de la minute est ta récupération. Tu enchaînes N minutes."
          }
        }
      }
    },
    "glossary.emom.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EMOM — Every Minute On the Minute"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "EMOM — Cada minuto, al minuto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EMOM — Chaque minute, à la minute"
          }
        }
      }
    },
    "glossary.en.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swimming aerobic zones: EN1 = easy (warm-up, recovery), EN2 = steady aerobic (most training volume), EN3 = upper aerobic (sustained, just below threshold)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonas aeróbicas en natación: EN1 = fácil (calentamiento, recuperación), EN2 = aeróbico sostenido (la mayor parte del volumen), EN3 = aeróbico alto (justo por debajo del umbral)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zones aérobie en natation : EN1 = facile (échauffement, récup), EN2 = aérobie soutenue (la majorité du volume), EN3 = aérobie haute (juste sous le seuil)."
          }
        }
      }
    },
    "glossary.en.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EN1 / EN2 / EN3 — Swim endurance zones"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "EN1 / EN2 / EN3 — Zonas de resistencia en natación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EN1 / EN2 / EN3 — Zones d'endurance natation"
          }
        }
      }
    },
    "glossary.entry.detail.sports": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deportes implicados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sports concernés"
          }
        }
      }
    },
    "glossary.entry.detail.title": {
      "extractionState": "manual",
      "localizations": {
