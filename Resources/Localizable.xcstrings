          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EPOC"
          }
        }
      }
    },
    "glossary.hiit.microinterval.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very short interval (10-30s) at very high intensity, followed by a brief recovery."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalle très court (10-30s) à très haute intensité, suivi d'une récup brève."
          }
        }
      }
    },
    "glossary.hiit.microinterval.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
