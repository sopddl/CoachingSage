    "onboarding.parq.header.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your safety"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por tu seguridad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ta sécurité"
          }
        }
      }
    },
    "onboarding.parq.leon.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One last thing, for your safety: 5 quick questions, the same for everyone. Just so I set your sessions right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una última cosa, por tu seguridad: 5 preguntas rápidas, las mismas para todos. Solo para ajustar bien tus sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière chose, pour ta sécurité : 5 questions rapides, les mêmes pour tout le monde. Ça sert juste à bien régler tes séances."
          }
        }
      }
    },
    "onboarding.parq.leon.risk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it. To be safe, I'll start gentle — we'll adjust together. A medical check before pushing is always a good idea."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anotado. Por prudencia, empezaré con una intensidad suave — lo ajustaremos juntos. Consultar a un médico antes de exigirte siempre es buena idea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noté. Par prudence, je partirai sur une intensité douce — on ajustera ensemble. Un avis médical avant de pousser, c'est toujours une bonne idée."
          }
        }
      }
    },
    "onboarding.closing.leon.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There we go 🎉 Glad to have you with me, %@."
          }
        },
        "es": {
          "stringUnit": {
