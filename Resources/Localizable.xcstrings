      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes your account and all your data. Final purge happens within 30 days as required by GDPR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprimera définitivement votre compte et toutes vos données. La purge définitive est effectuée sous 30 jours conformément au RGPD."
          }
        }
      }
    },
