    "onboarding.fil.greeting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi! I'm Léon, your coach here. What should I call you?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hola! Soy Léon, tu entrenador aquí. ¿Cómo te llamo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salut ! Moi c'est Léon, ton coach ici. Comment je t'appelle ?"
          }
        }
      }
    },
    "onboarding.fil.sports.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nice to meet you, %@ 👋 Tell me what you do — I'll build sessions that fit you. Pick as many as you like, you can change later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encantado, %@ 👋 Dime qué practicas — te prepararé sesiones a tu medida. Elige las que quieras, podrás cambiarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enchanté, %@ 👋 Dis-moi ce que tu pratiques — je te préparerai des séances qui te ressemblent. Choisis-en autant que tu veux, tu pourras changer."
          }
        }
      }
    },
    "onboarding.fil.sports.prompt.noname": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me what you do — I'll build sessions that fit you. Pick as many as you like, you can change later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dime qué practicas — te prepararé sesiones a tu medida. Elige las que quieras, podrás cambiarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-moi ce que tu pratiques — je te préparerai des séances qui te ressemblent. Choisis-en autant que tu veux, tu pourras changer."
          }
        }
      }
    },
    "onboarding.fil.consent.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I look at your workouts — duration, distance, frequency — to suggest better. Never your weight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miro tus sesiones de deporte — duración, distancia, frecuencia — para proponerte mejor. Nunca tu peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je regarde tes séances de sport — durée, distance, fréquence — pour mieux te proposer. Jamais ton poids."
          }
        }
      }
    },
