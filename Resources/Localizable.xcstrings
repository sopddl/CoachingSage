          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sweet-Spot (vélo)"
          }
        }
      }
    },
    "glossary.tabata.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 rounds of 20 sec all-out effort + 10 sec rest = 4 minutes total. Originally designed for VO2max + anaerobic capacity research."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 répétitions de 20 sec à fond + 10 sec de repos = 4 min au total. Protocole d'origine japonaise pour cibler VO2max + capacité anaérobie."
          }
        }
      }
    },
    "glossary.tabata.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabata 20/10"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabata 20/10"
          }
        }
      }
    },
    "glossary.vdot.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A number derived from a recent race that predicts your training paces (E, M, T, I, R). Higher VDOT = fitter runner. Often estimated from a 5K or 10K time."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nombre dérivé d'une course récente qui prédit tes allures d'entraînement (E, M, T, I, R). Plus le VDOT est élevé, plus tu es performant. Souvent estimé à partir d'un 5K ou 10K."
          }
        }
      }
    },
    "glossary.vdot.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VDOT — Daniels' running fitness score"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VDOT — Score de forme Daniels"
          }
        }
      }
    },
    "glossary.zones.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heart-rate zones based on your max HR. Z1-Z2 = easy aerobic (chat possible), Z3 = tempo (short sentences), Z4 = threshold (1-2 words), Z5 = maximal (no talking)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zones de fréquence cardiaque calculées sur ta FC max. Z1-Z2 = aérobie facile (tu peux discuter), Z3 = tempo (phrases courtes), Z4 = seuil (1-2 mots), Z5 = maximal (parler impossible)."
          }
        }
      }
    },
    "glossary.zones.title" : {
      "extractionState" : "stale",
      "localizations" : {
