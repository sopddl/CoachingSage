    "glossary.yoga.bandha.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A targeted inner contraction (throat, belly, pelvic floor) used by advanced practitioners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contracción interna localizada (garganta, vientre, suelo pélvico) utilizada por los practicantes avanzados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraction interne ciblée (gorge, ventre, plancher pelvien) utilisée par les pratiquants avancés."
          }
        }
