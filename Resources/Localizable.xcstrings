            "value" : "Transition"
          }
        }
      }
    },
    "glossary.football.unetouche.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The player passes the ball with a single contact, without controlling it first."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le joueur remet la balle en un seul contact, sans la contrôler."
          }
        }
      }
    },
    "glossary.football.unetouche.title" : {
      "extractionState" : "manual",
