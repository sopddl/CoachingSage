    "coaching.session.why.endurance.early": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This endurance outing builds your aerobic reservoir. It's the foundation on which the rest of the program will rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión de resistencia construye tu reserva aeróbica. Es la base sobre la que se apoyará todo el resto del programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette séance en endurance construit ton réservoir aérobie. C'est la fondation sur laquelle reposera toute la suite du programme."
          }
        }
      }
    },
    "coaching.session.why.endurance.late": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easy endurance in taper phase: maintain without fatiguing. Low RPE, fresh legs at the door."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resistencia fácil en fase de puesta a punto: se mantiene sin fatigar. RPE bajo, piernas frescas al salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Endurance facile en phase d'affûtage : on entretient sans fatiguer. RPE bas, jambes fraîches au départ."
          }
        }
      }
    },
    "coaching.session.why.endurance.mid": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endurance anchored: consolidate the aerobic base without raising intensity. The engine gets oiled, low RPE, max enjoyment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resistencia anclada: se consolida la base aeróbica sin subir la intensidad. El motor se engrasa, RPE bajo, máximo disfrute."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Endurance ancrée : on consolide la base aérobie sans monter en intensité. Le moteur s'huile, RPE bas, plaisir maximal."
          }
        }
      }
    },
    "coaching.session.why.expand.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to expand"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para desplegar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tape pour déplier"
          }
        }
      }
    },
    "coaching.session.why.generic": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is part of this week's progression."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión forma parte de la progresión de tu semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette séance s'inscrit dans la progression de ta semaine."
          }
        }
      }
    },
    "coaching.session.why.interval.early": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This interval session lays the VO2max foundations. In the first weeks, we learn to run fast without oxygen debt — quality over quantity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión de fraccionado asienta los cimientos del VO2máx. Las primeras semanas, aprendes a correr rápido sin deuda de oxígeno: la calidad prima sobre la cantidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette séance fractionnée installe les fondations VO2max. Les premières semaines, on apprend à courir vite sans dette d'oxygène — la qualité prime sur la quantité."
          }
        }
      }
    },
    "coaching.session.why.interval.late": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last intense phase before the taper: we target race specificity with intervals close to goal pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última fase intensa antes de la puesta a punto: apuntamos a la especificidad de la prueba con intervalos cercanos al ritmo objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière phase intense avant l'affûtage : on cible la spécificité de l'épreuve avec des intervalles proches de l'allure objectif."
          }
        }
      }
    },
    "coaching.session.why.interval.mid": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You now know how to run fast. Today we densify VO2max work: more sets, controlled recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya sabes correr rápido. Hoy densificamos el trabajo de VO2máx: más series, recuperación controlada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sais maintenant courir vite. Aujourd'hui, on densifie le travail de VO2max : plus de séries, récupération maîtrisée."
          }
        }
      }
    },
    "coaching.session.why.mixed.any": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixed session: we combine several qualities in one slot. No feat on a single axis, but a global workout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión mixta: combinamos varias cualidades en la misma franja. Sin proeza en un solo eje, sino un trabajo global."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séance mixte : on combine plusieurs qualités sur le même créneau. Pas de prouesse sur un seul axe, mais un travail global."
          }
        }
      }
    },
    "coaching.session.why.mobility.any": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easy session: your body consolidates adaptations from hard sessions. Max RPE 2-3."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión de descarga: tu cuerpo consolida las adaptaciones de las sesiones duras. RPE 2-3 máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séance d'allègement : ton corps consolide les adaptations des séances dures. RPE 2-3 max."
          }
        }
      }
    },
    "coaching.session.why.strength.early": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Base strength: we anchor motor patterns before loading. Slow tempo, technique before performance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuerzo de base: anclamos los patrones motores antes de subir la carga. Tempo lento, técnica antes que rendimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforcement de base : on ancre les patterns moteurs avant de monter en charge. Tempo lent, technique avant performance."
          }
        }
      }
    },
    "coaching.session.why.strength.late": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muscular taper: maintain gains without creating new fatigue. Moderate loads, focus on cleanliness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puesta a punto muscular: se mantiene lo adquirido sin generar nueva fatiga. Cargas moderadas, foco en la limpieza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affûtage musculaire : on entretient les acquis sans créer de nouvelle fatigue. Charges modérées, focus sur la propreté."
          }
        }
      }
    },
    "coaching.session.why.strength.mid": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength work has laid its foundations — now we seek functional hypertrophy. More ambitious loads, longer sets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trabajo de fuerza ya ha sentado sus bases: ahora buscamos la hipertrofia funcional. Cargas más ambiciosas, series más largas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le travail de force a posé ses bases — on cherche maintenant l'hypertrophie fonctionnelle. Charges plus ambitieuses, séries plus longues."
          }
        }
      }
    },
    "coaching.session.why.technique.any": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technique work: we isolate a movement to automate it. No cardiovascular stake — we seek cleanliness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajo técnico: aislamos un gesto para automatizarlo. Sin exigencia cardiovascular: buscamos la limpieza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travail technique : on isole un geste pour l'automatiser. Pas d'enjeu cardiovasculaire — on cherche la propreté."
          }
        }
      }
    },
    "coaching.session.why.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why this session?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué esta sesión?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi cette séance ?"
          }
        }
      }
    },
    "coaching.tip.bicepsCurl": {},
    "coaching.tip.birdDog": {},
    "coaching.tip.calfRaise": {},
    "coaching.tip.clamshell": {},
    "coaching.tip.core": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim for a straight line from shoulders to hips to heels. If your hips drop, shorten the hold rather than break form."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca la línea recta hombros-cadera-talones. Si la cadera baja, acorta el tiempo en vez de romper la postura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche la ligne droite épaules-bassin-talons. Si ton bassin descend, raccourcis le temps plutôt que casser la posture."
          }
        }
      }
    },
    "coaching.tip.cycle.endurance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadence 80-90 rpm, legs spinning smoothly without lurches. Let your breath drive the effort, not the gear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadencia 80-90 rpm, piernas que pedalean fluidas sin tirones. El aliento dicta el esfuerzo, no el desarrollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadence 80-90 rpm, jambes qui tournent rond sans à-coups. Le souffle dicte l'effort, pas le braquet."
          }
        }
      }
    },
    "coaching.tip.cycle.interval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay seated on intervals, keep the cadence steady. Strength comes from consistency, not from a heavy gear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quédate sentado en los intervalos, mantén la cadencia. La fuerza viene de la regularidad, no del desarrollo pesado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste assis sur les fractions, garde la cadence. La force vient de la régularité, pas du braquet lourd."
          }
        }
      }
    },
    "coaching.tip.deadBug": {},
    "coaching.tip.facePull": {},
    "coaching.tip.foamRolling": {},
    "coaching.tip.forearmPlank": {},
    "coaching.tip.hinge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The movement comes from the hips, not the lower back. Feel your hamstrings stretching as you descend — they do the work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El movimiento viene de la cadera, no de la espalda. Siente cómo se estiran los isquiotibiales al bajar: son ellos los que hacen el trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mouvement vient de la hanche, pas du dos. Sens les ischio-jambiers s'étirer en descendant — c'est eux qui font le travail."
          }
        }
      }
    },
    "coaching.tip.hipThrust": {},
    "coaching.tip.kbSwing": {},
    "coaching.tip.lateralRaises": {},
    "coaching.tip.lunge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front knee tracks over the foot, back knee descends toward the floor without touching. Keep your torso upright."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodilla delantera en el eje del pie, rodilla trasera que baja hacia el suelo sin tocarlo. Tronco recto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genou avant dans l'axe du pied, genou arrière qui descend vers le sol sans toucher. Buste droit."
          }
        }
      }
    },
    "coaching.tip.mobility": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold each position 20-30 seconds without bouncing. Breathe deeply, release a little more on each exhale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén cada posición 20-30 segundos sin rebotar. Respira profundamente, relaja un poco más en cada espiración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens chaque position 20-30 secondes sans rebondir. Respire profondément, relâche à chaque expiration."
          }
        }
      }
    },
    "coaching.tip.nordicCurl": {},
    "coaching.tip.pallofPress": {},
    "coaching.tip.plyo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land soft with bent knees — that's what protects your joints. Aim for a silent landing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterrizaje suave con las rodillas flexionadas: es lo que protege tus articulaciones. Sin ruido al caer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterrissage moelleux genoux fléchis — c'est lui qui protège tes articulations. Pas de bruit à l'arrivée."
          }
        }
      }
    },
    "coaching.tip.pull.horizontal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull your elbows back while squeezing the shoulder blades. Torso stays stable, the work comes from arms and upper back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira de los codos hacia atrás apretando las escápulas. El tronco se mantiene estable, el movimiento viene de los brazos y la parte alta de la espalda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire les coudes vers l'arrière en serrant les omoplates. Le buste reste stable, le mouvement vient des bras et du haut du dos."
          }
        }
      }
    },
    "coaching.tip.pull.vertical": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Engage the shoulder blades (scapula) first before bending your arms. Full range: chin above the bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa primero las escápulas (omóplatos) antes de doblar los brazos. Movimiento completo: barbilla por encima de la barra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engage d'abord les omoplates (scapula) avant de plier les bras. Mouvement complet : menton au-dessus de la barre."
          }
        }
      }
    },
    "coaching.tip.push.horizontal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elbows close to the body (45°), not flared. Controlled descent until you graze, explosive push back up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Codos cerca del cuerpo (45°), no abiertos. Bajada controlada hasta rozar, empuje explosivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coudes proches du corps (45°), pas écartés. Descente contrôlée jusqu'à effleurer, poussée explosive."
          }
        }
      }
    },
    "coaching.tip.push.vertical": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brace your core before pressing overhead. No lower-back arch — abs stay engaged the entire movement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea el core antes de empujar por encima de la cabeza. Sin arqueo lumbar: abdominales apretados durante todo el movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille le gainage avant de pousser au-dessus de la tête. Pas de cambrure lombaire — abdos serrés pendant tout le mouvement."
          }
        }
      }
    },
    "coaching.tip.run.drills": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drills are about technique, not effort. Wide motion, upright posture, coordination first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El drill es técnica, no esfuerzo. Movimientos amplios, postura recta y coordinación ante todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le drill, c'est de la technique, pas de l'effort. Mouvements amples, posture droite, et coordination avant tout."
          }
        }
      }
    },
    "coaching.tip.run.endurance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation pace: if you can talk to an imaginary partner without panting, the rhythm is right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo de conversación: si puedes hablar con un compañero imaginario sin jadear, el ritmo es bueno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allure de conversation : si tu peux parler à un partenaire imaginaire sans haleter, le rythme est bon."
          }
        }
      }
    },
    "coaching.tip.run.interval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the fast portion, aim for an effort around 8/10 — the goal is to hold the entire interval without cracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la fracción rápida, busca un esfuerzo en torno a 8/10: el objetivo es aguantar el intervalo entero sin reventar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la fraction rapide, vise un effort autour de 8/10 — l'objectif est de tenir l'intervalle entier sans craquer."
          }
        }
      }
    },
    "coaching.tip.squat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus on a controlled 3-second descent and push through your heels. Knees tracking over the toes, back straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concéntrate en la bajada controlada de 3 segundos y el empuje con los talones. Rodillas en el eje de los pies, espalda recta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentre-toi sur la descente contrôlée 3 secondes et la poussée par les talons. Genoux dans l'axe des pieds, dos droit."
          }
        }
      }
    },
    "coaching.tip.swim.drill": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical drills aren't a race — go slowly, feel every phase of the stroke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El drill técnico no es una carrera: hazlo despacio, siente cada fase del gesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le drill technique n'est pas une course — fais lentement, sens chaque phase du geste."
          }
        }
      }
    },
    "coaching.tip.swim.endurance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long glide between each stroke. Breathe every 3 cycles to balance left and right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizamiento largo entre cada brazada. Respira cada 3 tiempos para equilibrar izquierda/derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse longue entre chaque coup de bras. Respire tous les 3 temps pour équilibrer gauche/droite."
          }
        }
      }
    },
    "coaching.tip.tricepsPushdown": {},
    "coaching.tip.yoga": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seek the breath before the depth. A comfortable posture held for 5 breaths is worth more than a forced one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca la respiración antes que la profundidad. Una postura cómoda mantenida 5 respiraciones vale más que una postura forzada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche la respiration avant la profondeur. Une posture confortable et tenue 5 respirations vaut mieux qu'une posture forcée."
          }
        }
      }
    },
    "coaching.tip.ytwActivation": {},
