          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Service kické"
          }
        }
      }
    },
    "glossary.tennis.slice.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shot hit with backspin: the ball stays low after the bounce."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpe con efecto cortado (back): la bola se queda baja tras el bote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coup frappé avec effet coupé (rétro) : la balle reste basse après le rebond."
          }
        }
      }
    },
    "glossary.tennis.slice.title": {
