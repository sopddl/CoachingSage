        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprimera définitivement votre compte et toutes vos données. La purge définitive est effectuée sous 30 jours conformément au RGPD."
          }
        }
      }
    },
