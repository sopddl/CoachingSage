          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strides — Lignes droites"
          }
        }
      }
    },
    "glossary.sweetspot.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "88-94% of FTP. Sustainable for 15-40 min, very effective stimulus for FTP gains without the recovery cost of pure threshold work."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "88-94% de la FTP. Tenable 15-40 min, stimulus très efficace pour augmenter la FTP sans le coût de récupération du seuil pur."
          }
        }
      }
    },
    "glossary.sweetspot.title" : {
      "extractionState" : "stale",
