    "dashboard.leon.tip.late.format": {
      "comment": "Story 3.29 — conseil Léon, séance en retard. param: type séance",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session's been waiting since last week. No pressure, ease back in — next up: %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes una sesión pendiente desde la semana pasada. Sin presión, retómala con calma: próxima: %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une séance t'attend depuis la semaine dernière. Pas de pression, reprends tranquille — prochaine : %1$@."
          }
