    "glossary.vma.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VMA (maximal aerobic speed)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VMA (velocidad aeróbica máxima)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VMA (vitesse maximale aérobie)"
          }
        }
      }
    },
    "glossary.vma.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fastest pace you can hold for about 5 to 6 minutes, breathing all-out, too hard to talk. It's used as a reference to set your fast (interval) sessions. Here, « VMA pace » means « very fast, close to your max effort over a few minutes »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el ritmo más rápido que puedes mantener unos 5 a 6 minutos, respirando a tope, sin poder hablar. Sirve de referencia para calibrar las series rápidas (fraccionado). Aquí, « ritmo VMA » significa « muy rápido, cerca de tu esfuerzo máximo en unos minutos »."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est l'allure la plus rapide que tu peux tenir environ 5 à 6 minutes, souffle à fond, sans pouvoir parler. Elle sert de repère pour calibrer les séances rapides (fractionné). Ici, « allure VMA » veut dire « très rapide, proche de ton effort max sur quelques minutes »."
          }
        }
      }
    },
    "glossary.seuil.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Threshold pace"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo umbral"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allure au seuil"
          }
        }
      }
    },
    "glossary.seuil.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sustained but holdable pace: you can manage 4-5 words, not a full sentence. It feels « comfortably hard » and steady. It's the pace that builds your race endurance without wiping you out. Stay even and don't start too fast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ritmo exigente pero sostenible mucho rato: puedes soltar 4-5 palabras, no una frase entera. La sensación es « cómodamente duro » y estable. Es el ritmo que desarrolla tu resistencia de carrera sin agotarte. Mantente regular y no salgas demasiado rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est une allure soutenue mais tenable longtemps : tu peux lâcher 4-5 mots, pas une phrase entière. La sensation est « confortablement dur » et stable. C'est l'allure qui développe ton endurance de course sans t'épuiser. Reste régulier et ne pars pas trop vite."
          }
        }
      }
    },
    "glossary.affutage.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taper"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Afinamiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affûtage"
          }
        }
      }
    },
    "glossary.affutage.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The final phase before a race: you cut the volume (shorter distances) while keeping a bit of speed, so you arrive fresh and rested on race day. Your legs may feel heavy at first — that's normal, the body is recovering. Don't try to do more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última fase antes de una carrera: reduces el volumen (distancias más cortas) manteniendo algo de velocidad, para llegar fresco y descansado el día de la prueba. Las piernas pueden sentirse pesadas al principio, es normal: el cuerpo se recupera. No intentes hacer más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est la dernière phase avant une course : on réduit le volume (distances plus courtes) tout en gardant un peu de vitesse, pour arriver frais et reposé le jour J. Les jambes peuvent sembler lourdes au début, c'est normal — le corps récupère. Ne cherche pas à en faire plus."
          }
        }
      }
    },
    "glossary.aerobie.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerobic base"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Base aeróbica"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Endurance aérobie (base)"
          }
        }
      }
    },
    "glossary.aerobie.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's your « endurance engine »: the ability to run for a long time at an easy pace where you can hold a conversation. You build it mostly by running slowly and often. It's the foundation of all running progress, even for getting faster later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es tu « motor de fondo »: la capacidad de correr mucho tiempo a ritmo fácil, donde puedes mantener una conversación. Se construye sobre todo corriendo despacio y a menudo. Es la base de todo progreso en carrera, incluso para ir rápido después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est ton « moteur de fond » : la capacité à courir longtemps à allure facile, où tu peux tenir une conversation. On la construit surtout en courant lentement et souvent. C'est la fondation de toute progression en course à pied, même pour aller vite ensuite."
          }
        }
      }
    },
    "glossary.excentrique.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eccentric work"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajo excéntrico"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travail excentrique"
          }
        }
      }
    },
    "glossary.excentrique.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phase where the muscle contracts while lengthening — the moment you brake a movement (for example lowering slowly onto your toes). This braking work strengthens the tendons and muscles most stressed by running. Always do it slowly and under control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la fase en la que el músculo se contrae mientras se alarga, o sea el momento en que frenas un movimiento (por ejemplo bajar despacio sobre la punta de los pies). Ese trabajo de frenado refuerza los tendones y músculos más exigidos al correr. Hazlo siempre despacio y controlado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est la phase où le muscle se contracte en s'allongeant, c'est-à-dire le moment où tu freines un mouvement (par exemple descendre lentement sur la pointe des pieds). Ce travail de freinage renforce les tendons et muscles très sollicités en course. Fais-le toujours lentement et contrôlé."
          }
        }
      }
    },
    "glossary.fcmax.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max HR (maximum heart rate)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FCmáx (frecuencia cardíaca máxima)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FCmax (fréquence cardiaque maximale)"
          }
        }
      }
    },
    "glossary.fcmax.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your highest possible heart rate. Percentages (e.g. 90-95% max HR) help target intensity if you ride with a heart-rate monitor — otherwise go by feel and RPE."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu frecuencia cardíaca más alta posible. Los porcentajes (p. ej. 90-95 % FCmáx) sirven para fijar la intensidad si llevas pulsómetro — si no, guíate por la sensación y el RPE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta fréquence cardiaque la plus haute possible. Les pourcentages (ex. 90-95 % FCmax) servent à cibler l'intensité si tu as un cardiofréquencemètre — sinon fie-toi à la sensation et au RPE."
          }
        }
      }
    },
