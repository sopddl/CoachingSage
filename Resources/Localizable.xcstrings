    "glossary.vdot.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A number derived from a recent race that predicts your training paces (E, M, T, I, R). Higher VDOT = fitter runner. Often estimated from a 5K or 10K time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un número derivado de una carrera reciente que predice tus ritmos de entrenamiento (E, M, T, I, R). Cuanto más alto es el VDOT, más rendimiento tienes. A menudo se estima a partir de un 5K o un 10K."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre dérivé d'une course récente qui prédit tes allures d'entraînement (E, M, T, I, R). Plus le VDOT est élevé, plus tu es performant. Souvent estimé à partir d'un 5K ou 10K."
          }
        }
      }
    },
    "glossary.vdot.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VDOT — Daniels' running fitness score"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VDOT — Puntuación de forma de Daniels"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VDOT — Score de forme Daniels"
          }
        }
      }
    },
    "glossary.vo2max.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum amount of oxygen the body can use during intense exercise. Targeted by short hard intervals (3-5 min, Daniels-I / Tabata / FTP-Z5)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cantidad máxima de oxígeno que el cuerpo puede utilizar en esfuerzo intenso. Se trabaja con los intervalos cortos y duros (3-5 min, Daniels-I / Tabata / FTP-Z5)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantité maximale d'oxygène que le corps peut utiliser à l'effort intense. Ciblée par les intervalles courts et durs (3-5 min, Daniels-I / Tabata / FTP-Z5)."
          }
        }
      }
    },
    "glossary.vo2max.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2max — Maximal aerobic capacity"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2máx — Capacidad aeróbica máx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VO2max — Capacité aérobie max"
          }
        }
      }
    },
    "glossary.yoga.asana.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A yoga posture held for several breaths to work the body and focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Postura de yoga mantenida varias respiraciones para trabajar el cuerpo y la atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posture de yoga tenue plusieurs respirations pour travailler corps et attention."
          }
        }
      }
    },
