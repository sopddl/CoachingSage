    "glossary.intervals.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training method alternating hard efforts with active or passive recovery. Builds aerobic and anaerobic capacity faster than steady-state work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Método de entrenamiento que alterna esfuerzos sostenidos y recuperación activa o pasiva. Desarrolla las capacidades aeróbica y anaeróbica más rápido que un esfuerzo continuo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Méthode d'entraînement alternant efforts soutenus et récupération active ou passive. Développe les capacités aérobie et anaérobie plus vite qu'un effort continu."
          }
        }
      }
    },
    "glossary.intervals.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervals — Effort/recovery blocks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalos — Bloques de esfuerzo/recuperación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalles — Blocs effort/récupération"
          }
        }
      }
    },
    "glossary.lactate.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Substance produced by muscles during intense effort. Above the lactate threshold it accumulates faster than the body can clear it, causing burn and forcing slowdown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustancia producida por los músculos en esfuerzo intenso. Por encima del umbral láctico se acumula más rápido de lo que el cuerpo puede eliminarlo, lo que provoca la sensación de ardor y obliga a bajar el ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Substance produite par les muscles à effort intense. Au-dessus du seuil lactique, il s'accumule plus vite que le corps ne peut l'éliminer, ce qui provoque la sensation de brûlure et force à ralentir."
          }
        }
      }
    },
    "glossary.lactate.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lactate — Effort byproduct"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lactato — Subproducto del esfuerzo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lactate — Sous-produit de l'effort"
          }
        }
      }
    },
    "glossary.plank.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Static core hold on forearms (or extended arms) and toes, body in a straight line from shoulders to heels. Side plank variant: side-lying with one forearm on the floor and feet stacked — works the obliques. Hold without letting hips drop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plancha estática sobre los antebrazos (o brazos estirados) y las puntas de los pies, con el cuerpo en línea recta de hombros a talones. Variante lateral (side plank): de lado, un solo antebrazo en el suelo, pies apilados — trabaja los oblicuos. Aguanta sin dejar caer la cadera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gainage statique sur les avant-bras (ou bras tendus) et la pointe des pieds, corps en ligne droite épaules-talons. Variante latérale (side plank) : sur le côté, un seul avant-bras au sol, pieds empilés — travaille les obliques. Tenir sans laisser tomber le bassin."
          }
        }
      }
    },
    "glossary.plank.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plank — Isometric core hold"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plancha — Trabajo de core isométrico"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plank (planche) — Gainage isométrique"
          }
        }
      }
    },
    "glossary.plyometric.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercises involving rapid stretch then powerful contraction (jumps, bounds, hops). Develop power, neuromuscular speed and reactive strength."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejercicios con estiramiento rápido y luego contracción potente (saltos, rebotes). Desarrollan la potencia, la velocidad neuromuscular y la fuerza reactiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercices avec étirement rapide puis contraction puissante (sauts, bondissements). Développent la puissance, la vitesse neuromusculaire et la force réactive."
          }
        }
      }
    },
    "glossary.plyometric.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plyometric — Explosive jumps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliométrico — Saltos explosivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliométrique — Sauts explosifs"
          }
        }
      }
    },
    "glossary.pushoff.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerful push from the pool wall after a turn (~5-8m underwater). Free distance — boosts overall lap time but skews lap-by-lap pace measurements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuje potente de la pared tras un viraje (~5-8 m bajo el agua). Distancia gratis — mejora el tiempo global por largo pero falsea la medición del ritmo largo a largo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poussée puissante du mur après un virage (~5-8m sous l'eau). Distance gratuite — améliore le temps global au tour mais fausse la mesure du pace lap par lap."
          }
        }
      }
    },
    "glossary.pushoff.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-off — Wall kick (swimming)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-off — Empuje en la pared (natación)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-off — Poussée au mur (natation)"
          }
        }
      }
    },
    "glossary.race.pace.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pace you'd hold for that distance in a race. 5K pace ≈ Daniels-I/T, 10K pace ≈ Daniels-T. Used as a concrete intensity target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ritmo sostenible en esa distancia en carrera. Ritmo 5K ≈ Daniels-I/T, ritmo 10K ≈ Daniels-T. Sirve como objetivo concreto de intensidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'allure tenable sur cette distance en course. Allure 5K ≈ Daniels-I/T, allure 10K ≈ Daniels-T. Sert de cible d'intensité concrète."
          }
        }
      }
    },
    "glossary.race.pace.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Race pace (5K, 10K…)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo de carrera (5K, 10K…)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allure course (5K, 10K…)"
          }
        }
      }
    },
    "glossary.rampup.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progressively increase load over 2-3 sets before your working set. Primes the nervous system and reduces injury risk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subir progresivamente la carga en 2-3 series antes de la serie de trabajo. Prepara el sistema nervioso y reduce el riesgo de lesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monter progressivement en charge sur 2-3 séries avant la série de travail. Prépare le système nerveux et limite le risque de blessure."
          }
        }
      }
    },
    "glossary.rampup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramp up — Progressive loading"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramp up — Subida progresiva de carga"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramp up — Montée en charge"
          }
        }
      }
    },
    "glossary.reps.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reps = abbreviation for repetitions. '10 reps' = 10 movement repetitions in a single set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reps = abreviatura de repeticiones. '10 reps' = 10 repeticiones del movimiento en una sola serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reps = abréviation de répétitions. '10 reps' = 10 répétitions du mouvement dans une seule série."
          }
        }
      }
    },
    "glossary.reps.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reps — Repetitions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reps — Repeticiones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reps — Répétitions"
          }
        }
      }
    },
    "glossary.rir.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reps in reserve = how many reps you could still do before total failure. RIR 2 = stop 2 reps before you can't do any more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reps en reserva = cuántas repeticiones más podrías hacer antes del fallo. RIR 2 = párate 2 repeticiones antes de no poder más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reps en réserve = combien de répétitions tu pourrais encore faire avant l'échec. RIR 2 = arrête-toi 2 répétitions avant de ne plus pouvoir."
          }
        }
      }
    },
    "glossary.rir.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RIR — Reps In Reserve"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RIR — Reps In Reserve"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RIR — Reps In Reserve"
          }
        }
      }
    },
    "glossary.rpe.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Borg 1-10 scale: how hard a session feels. 1 = very easy, 5 = moderate, 10 = maximal sprint. Subjective but reliable to gauge intensity without sensors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala de Borg 1-10: cuánto cuesta la sesión. 1 = muy fácil, 5 = moderado, 10 = sprint máximo. Subjetivo pero fiable para medir la intensidad sin sensor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échelle de Borg 1-10 : à quel point la séance est dure. 1 = très facile, 5 = modéré, 10 = sprint maximal. Subjectif mais fiable pour jauger l'intensité sans capteur."
          }
        }
      }
    },
    "glossary.rpe.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RPE — Perceived effort"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RPE — Esfuerzo percibido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RPE — Effort ressenti"
          }
        }
      }
    },
    "glossary.scapular.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scapula = shoulder blade. Scapular mobility = moving shoulder blades independently from arms (up/down, front/back, rotation). Essential for healthy shoulders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escápula = omóplato. Movilidad escapular = mover los omóplatos de forma independiente de los brazos (arriba/abajo, adelante/atrás, rotación). Esencial para unos hombros sanos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scapula = omoplate. Mobilité scapulaire = bouger les omoplates indépendamment des bras (haut/bas, avant/arrière, rotation). Essentiel pour des épaules saines."
          }
        }
      }
    },
    "glossary.scapular.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scapular — Shoulder blade"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escapular — Omóplato"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scapulaire — Omoplate"
          }
        }
      }
    },
    "glossary.strides.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short controlled accelerations (~20-30 sec, 80-100m) on the flat or slight downhill. Improves form and leg turnover without taxing energy systems."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceleraciones cortas y controladas (~20-30 s, 80-100 m) en llano o ligera bajada. Mejora la zancada y la cadencia sin fatigar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accélérations courtes contrôlées (~20-30 sec, 80-100m) sur le plat ou légère descente. Améliore la foulée et la cadence sans fatiguer."
          }
        }
      }
    },
    "glossary.strides.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strides — Short accelerations"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Strides — Rectas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Strides — Lignes droites"
          }
        }
      }
    },
    "glossary.sweetspot.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "88-94% of FTP. Sustainable for 15-40 min, very effective stimulus for FTP gains without the recovery cost of pure threshold work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "88-94% de la FTP. Sostenible 15-40 min, estímulo muy eficaz para aumentar la FTP sin el coste de recuperación del umbral puro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "88-94% de la FTP. Tenable 15-40 min, stimulus très efficace pour augmenter la FTP sans le coût de récupération du seuil pur."
          }
        }
      }
    },
    "glossary.sweetspot.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweet-Spot (cycling)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweet-Spot (ciclismo)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweet-Spot (vélo)"
          }
        }
      }
    },
    "glossary.tabata.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8 rounds of 20 sec all-out effort + 10 sec rest = 4 minutes total. Originally designed for VO2max + anaerobic capacity research."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "8 repeticiones de 20 s a tope + 10 s de descanso = 4 min en total. Protocolo de origen japonés para apuntar al VO2máx + capacidad anaeróbica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "8 répétitions de 20 sec à fond + 10 sec de repos = 4 min au total. Protocole d'origine japonaise pour cibler VO2max + capacité anaérobie."
          }
        }
      }
    },
    "glossary.tabata.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabata 20/10"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabata 20/10"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabata 20/10"
          }
        }
      }
    },
    "glossary.tempo.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustained running, cycling or rowing pace — comfortable but firm. Between easy aerobic and lactate threshold (RPE 6-7)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo de carrera, ciclismo o remo sostenido — exigente pero mantenible. Entre el aeróbico fácil y el umbral láctico (RPE 6-7)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allure de course, vélo ou rameur soutenue — exigeante mais tenable. Entre l'aérobie facile et le seuil lactique (RPE 6-7)."
          }
        }
      }
    },
    "glossary.tempo.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo — Sustained pace"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo — Ritmo sostenido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo — Allure soutenue"
          }
        }
      }
    },
    "glossary.tennis.footwork.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Footwork and movement drills to arrive well-positioned on the ball."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajo de apoyos y desplazamientos para llegar bien colocado a la bola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travail des appuis et déplacements pour arriver bien placé sur la balle."
          }
        }
      }
    },
    "glossary.tennis.footwork.title": {
