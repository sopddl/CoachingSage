          }
        }
      }
    },
    "glossary.tennis.kickserve.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heavily spun serve that bounces high and jumps sideways."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saque muy liftado que bota alto y sale hacia un lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Service très lifté qui rebondit haut et part sur le côté."
          }
        }
      }
    },
