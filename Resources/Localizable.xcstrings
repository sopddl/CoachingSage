{
  "sourceLanguage": "fr",
  "strings": {
    "questionnaire.cycling.q5.text": {
      "comment": "Indoor/outdoor vélo (2026-06-11) — question lieu posée dans le questionnaire de création vélo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you ride mostly outdoors or on a home trainer?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ruedas más al aire libre o en rodillo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu roules plutôt dehors ou en home-trainer ?"
          }
        }
      }
    },
    "questionnaire.cycling.q5.option.outdoor": {
      "comment": "Indoor/outdoor vélo (2026-06-11) — question lieu posée dans le questionnaire de création vélo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostly outdoors 🛣️"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más al aire libre 🛣️"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plutôt dehors 🛣️"
          }
        }
      }
    },
    "questionnaire.cycling.q5.option.indoor": {
      "comment": "Indoor/outdoor vélo (2026-06-11) — question lieu posée dans le questionnaire de création vélo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostly home trainer 🏠"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más en rodillo 🏠"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plutôt en home-trainer 🏠"
          }
        }
      }
    },
    "questionnaire.cycling.q5.option.both": {
      "comment": "Indoor/outdoor vélo (2026-06-11) — question lieu posée dans le questionnaire de création vélo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both, choose day to day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos, elijo según el día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux, je choisis selon le jour"
          }
        }
      }
    },
    "coaching.dosage.charge.hold": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold: keep the position tight until it gets hard (a little shaking is fine)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Isometría: mantén la posición firme hasta que cueste (temblar un poco es normal)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenue : garde la position bien gainée jusqu'à ce que ça devienne dur (ça peut trembler un peu)."
          }
        }
      }
    },
    "coaching.zone.sensation.load.75": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
