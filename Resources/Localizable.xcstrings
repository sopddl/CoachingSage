    "glossary.fartlek.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swedish for « speed play ». Unstructured workout alternating fast and slow segments based on feel, terrain or landmarks, rather than precise paces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sueco para « juego de ritmos ». Sesión no estructurada que alterna segmentos rápidos y lentos al feeling, según el terreno o referencias, en vez de a un ritmo preciso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suédois pour « jeu d'allures ». Séance non structurée alternant des segments rapides et lents au feeling, selon le terrain ou des repères, plutôt qu'à une allure précise."
          }
        }
      }
    },
    "glossary.fartlek.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fartlek — Speed play"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fartlek — Juego de ritmos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fartlek — Jeu d'allures"
          }
        }
      }
    },
    "glossary.football.rsa.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ability to repeat several short sprints with little recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacidad de encadenar varios sprints cortos con poca recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacité à enchaîner plusieurs sprints courts avec peu de récupération."
          }
        }
      }
    },
    "glossary.football.fifa11plus.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An 11-exercise warm-up program developed by FIFA to prevent injuries (running, core, balance, plyometrics). Done before training."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Programa de calentamiento de 11 ejercicios, creado por la FIFA para prevenir lesiones (carreras, core, equilibrio, pliometría). Se hace antes del entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme d'échauffement en 11 exercices, conçu par la FIFA pour prévenir les blessures (courses, gainage, équilibre, pliométrie). À faire avant l'entraînement."
          }
        }
      }
    },
    "glossary.football.fifa11plus.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FIFA 11+"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FIFA 11+"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FIFA 11+"
          }
        }
      }
    },
    "glossary.football.rsa.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RSA — Repeated Sprint Ability"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RSA — Repeated Sprint Ability"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RSA — Repeated Sprint Ability"
          }
        }
      }
    },
    "glossary.football.sprintrepete.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A series of short sprints (5-10s) with short recoveries, typical in football."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie de sprints cortos (5-10 s) intercalados con recuperaciones cortas, típica del fútbol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Série de sprints courts (5-10s) entrecoupés de récupérations courtes, typique du foot."
          }
        }
      }
    },
    "glossary.football.sprintrepete.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeated sprints"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprints repetidos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprints répétés"
          }
        }
      }
    },
    "glossary.football.transition.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moment a team switches from defending to attacking (or vice versa) after winning or losing the ball."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Momento en que el equipo pasa de la defensa al ataque (o viceversa) tras recuperar o perder el balón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moment où l'équipe passe de la défense à l'attaque (ou inverse) après récupération ou perte."
          }
        }
      }
    },
    "glossary.football.transition.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transition"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transición"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transition"
          }
        }
      }
    },
    "glossary.football.unetouche.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The player passes the ball with a single contact, without controlling it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El jugador devuelve el balón en un solo contacto, sin controlarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le joueur remet la balle en un seul contact, sans la contrôler."
          }
        }
      }
    },
    "glossary.football.unetouche.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-touch play"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juego a un toque"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeu à une touche"
          }
        }
      }
    },
    "glossary.ftp.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Power (watts) you can hold for ~1 hour on the bike. FTP-Z1 to Z7 are training zones derived from it. Z2 = endurance, Z4 = threshold, Z5+ = VO2max and above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Potencia (vatios) sostenible ~1 h en la bici. FTP-Z1 a Z7 son las zonas de entrenamiento derivadas. Z2 = resistencia, Z4 = umbral, Z5+ = VO2máx y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puissance (watts) tenable ~1h sur le vélo. FTP-Z1 à Z7 sont les zones d'entraînement dérivées. Z2 = endurance, Z4 = seuil, Z5+ = VO2max et plus."
          }
        }
      }
    },
    "glossary.ftp.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP — Functional Threshold Power (cycling)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP — Umbral funcional (ciclismo)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP — Seuil fonctionnel (vélo)"
          }
        }
      }
    },
    "glossary.hiit.epoc.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excess oxygen consumption after exercise: the body keeps burning calories for a while afterward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobreconsumo de oxígeno tras el esfuerzo: el cuerpo sigue quemando calorías un rato después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surconsommation d'oxygène après l'effort : le corps continue de brûler des calories un moment après."
          }
        }
      }
    },
    "glossary.hiit.epoc.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EPOC"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "EPOC"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EPOC"
          }
        }
      }
    },
    "glossary.hiit.microinterval.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very short interval (10-30s) at very high intensity, followed by a brief recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalo muy corto (10-30 s) a muy alta intensidad, seguido de una recuperación breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalle très court (10-30s) à très haute intensité, suivi d'une récup brève."
          }
        }
      }
    },
    "glossary.hiit.microinterval.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Micro-interval"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Micro-intervalo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Micro-intervalle"
          }
        }
      }
    },
    "glossary.hiit.workrest.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratio of work time to rest time: 30s/30s means a 1:1 ratio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Relación entre tiempo de esfuerzo y tiempo de recuperación: 30 s/30 s = ratio 1:1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapport temps d'effort sur temps de récup : 30s/30s = ratio 1:1."
          }
        }
      }
    },
    "glossary.hiit.workrest.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work-rest ratio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratio esfuerzo/recuperación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratio effort/récup"
          }
        }
      }
    },
    "glossary.hiking.denivele.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total meters climbed on the route: 500m D+ means 500m climbed in total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma de las subidas del recorrido, en metros: 500 m D+ = 500 m ascendidos en total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somme des montées du parcours, en mètres : 500m D+ = 500m grimpés au total."
          }
        }
      }
    },
    "glossary.hiking.denivele.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total ascent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desnivel positivo (D+)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dénivelé positif (D+)"
          }
        }
      }
    },
    "glossary.hiking.elevation.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Altitude difference between the lowest and highest point of the route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diferencia de altitud entre el punto más bajo y el punto más alto del recorrido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Différence d'altitude entre le point le plus bas et le point le plus haut du parcours."
          }
        }
      }
    },
    "glossary.hiking.elevation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevation gain"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Élévation"
          }
        }
      }
    },
    "glossary.hiking.switchback.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharp hairpin turn that lets a trail climb a steep slope in a zigzag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva cerrada en horquilla que permite subir una pendiente empinada en zigzag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Virage serré en épingle qui permet de monter une pente raide en zigzag."
          }
        }
      }
    },
    "glossary.hiking.switchback.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switchback"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lazada (switchback)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacet"
          }
        }
      }
    },
    "glossary.hiking.terrainpace.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pace that adapts to the terrain: slower uphill, faster on flat ground."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo que se adapta al terreno: se baja en subida, se acelera en llano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allure qui s'adapte au terrain : on ralentit en montée, on accélère sur le plat."
          }
        }
      }
    },
    "glossary.hiking.terrainpace.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terrain pace"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo según terreno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allure terrain"
          }
        }
      }
    },
    "glossary.hmp.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pace you'd hold for a half marathon (~85-90% HRmax). Between Daniels-M and Daniels-T. Common reference for tempo and long-run blocks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ritmo sostenible en un medio maratón (~85-90% de la FC máx.). Entre Daniels-M y Daniels-T. Referencia habitual para los bloques de tempo y la tirada larga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'allure tenable sur un semi-marathon (~85-90% FC max). Entre Daniels-M et Daniels-T. Référence courante pour les blocs tempo et sortie longue."
          }
        }
      }
    },
    "glossary.hmp.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HMP — Half-marathon pace"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HMP — Ritmo de medio maratón"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HMP — Allure semi-marathon"
          }
        }
      }
    },
    "glossary.hypertrophy.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength work focused on muscle size: typically 3-5 sets × 8-12 reps at ~65-75% 1RM with moderate rest (60-90s). Volume and time-under-tension drive growth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajo de fuerza orientado al tamaño muscular: típicamente 3-5 series × 8-12 reps al ~65-75% del 1RM con descanso moderado (60-90 s). El volumen y el tiempo bajo tensión impulsan el crecimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travail de force orienté taille musculaire : typiquement 3-5 séries × 8-12 reps à ~65-75 % 1RM avec repos modéré (60-90s). Le volume et le temps sous tension drivent la croissance."
          }
        }
      }
    },
    "glossary.hypertrophy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hypertrophy — Muscle volume training"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hipertrofia — Volumen muscular"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hypertrophie — Volume musculaire"
          }
        }
      }
    },
    "glossary.index.empty.description": {
