      }
    },
    "glossary.1rm.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your 1RM is the heaviest load you can lift once with proper form. %1RM expresses the working load as a fraction (e.g. 80% 1RM ≈ heavy strength work, 65% ≈ hypertrophy)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton 1RM est la charge la plus lourde que tu peux soulever 1 seule fois en bonne forme. %1RM exprime la charge de travail (ex. 80% 1RM ≈ force lourde, 65% ≈ hypertrophie)."
          }
        }
      }
    },
    "glossary.1rm.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1RM — Percentage of one-rep max"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1RM — Pourcentage du 1RM"
          }
        }
      }
    },
    "glossary.amrap.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A timed block where you do as many reps (or rounds of a circuit) as possible. Stop the clock, not the work, when you're done."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bloc chronométré où tu fais autant de reps (ou de tours de circuit) que possible. Quand le temps est écoulé, tu t'arrêtes — pas avant."
          }
        }
      }
    },
    "glossary.amrap.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMRAP — As Many Reps/Rounds As Possible"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMRAP — Le plus de reps/tours possible"
          }
        }
      }
    },
    "glossary.bandpullapart.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull an elastic band apart in front of you, arms extended, until it touches your chest. Strengthens upper back and shoulders. Classic warmup."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écarter une bande élastique tendue devant soi, bras tendus, jusqu'à ce qu'elle touche la poitrine. Renforce le haut du dos et les épaules. Échauffement classique."
          }
        }
      }
    },
    "glossary.bandpullapart.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Band pull apart"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écartement à l'élastique"
          }
        }
      }
    },
    "glossary.barrevide.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olympic barbell with no plates (20 kg / 45 lb). Used as warmup to rehearse the movement before adding load."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barre olympique sans aucun disque (20 kg). Sert d'échauffement pour répéter le geste avant d'ajouter les charges."
          }
        }
      }
    },
    "glossary.barrevide.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empty bar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barre vide"
          }
        }
      }
    },
    "glossary.cadence.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steps per minute (running, target ~175-185 spm), pedal revolutions per minute (cycling, target ~85-95 rpm), or arm cycles per 25m (swimming). Higher cadence = lower impact per stride and smoother power."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas par minute (course, cible ~175-185 ppm), tours de pédalier par minute (vélo, cible ~85-95 rpm), ou cycles de bras par 25m (natation). Cadence haute = moins d'impact par foulée et puissance plus fluide."
          }
        }
      }
    },
    "glossary.cadence.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadence — Stride/pedal/stroke rate"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadence — Fréquence pas/pédales/bras"
          }
        }
      }
    },
    "glossary.cars.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slow, controlled rotations of a joint (shoulder, hip, ankle) through its full range of motion. Used to mobilize and maintain joint flexibility."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotations lentes et contrôlées d'une articulation (épaule, hanche, cheville) au maximum de son amplitude. Sert à mobiliser et préserver la souplesse articulaire."
          }
        }
      }
    },
    "glossary.cars.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CARs — Controlled Articular Rotations"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CARs — Rotations articulaires contrôlées"
          }
        }
      }
    },
    "glossary.catcow.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On all fours, alternate hollow back (cow) and rounded back (cat). Mobilizes the spine, classic warmup in both strength and yoga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quatre pattes, alterner dos creux (cow, vache) et dos rond (cat, chat). Mobilise la colonne, échauffement classique en strength comme en yoga."
          }
        }
      }
    },
    "glossary.catcow.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cat-cow"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cat-cow (chat-vache)"
          }
        }
      }
    },
    "glossary.css.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sustainable maximum swimming pace over ~30 min. Used to calibrate threshold sets. Often measured with a 400m + 200m time-trial test."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta vitesse maximale tenable en nage continue sur ~30 min. Sert à calibrer les séances au seuil. Souvent mesurée via un test 400m + 200m chronométré."
          }
        }
      }
    },
    "glossary.css.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CSS — Critical Swim Speed"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CSS — Vitesse critique natation"
          }
        }
      }
    },
    "glossary.daniels.e.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversational, very aerobic pace from Jack Daniels' running formula. ~65-79% HRmax, all-day-able. The bulk of training volume sits here."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allure conversationnelle, très aérobie, issue de la méthode Jack Daniels. ~65-79% FC max, tenable longtemps. La majorité du volume d'entraînement se fait à cette allure."
          }
        }
      }
    },
    "glossary.daniels.e.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daniels-E — Easy"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daniels-E — Endurance facile"
          }
        }
      }
    },
    "glossary.daniels.i.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard intervals (~95-100% HRmax) targeting VO2max. Reps of 3-5 min with equal recovery. Improves aerobic ceiling."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalles durs (~95-100% FC max) ciblant la VO2max. Répétitions de 3-5 min avec récupération équivalente. Améliore le plafond aérobie."
          }
        }
      }
    },
    "glossary.daniels.i.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daniels-I — Interval (VO2max)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daniels-I — Intervalles VO2max"
          }
        }
      }
    },
    "glossary.daniels.m.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pace you'd hold for a marathon (~80-89% HRmax). Comfortable-hard, sustainable for 1-3h depending on fitness."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'allure tenable sur un marathon (~80-89% FC max). Confortable-soutenue, tenable 1 à 3h selon le niveau."
          }
        }
      }
    },
    "glossary.daniels.m.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daniels-M — Marathon pace"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daniels-M — Allure marathon"
          }
        }
      }
    },
    "glossary.daniels.r.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short fast reps (~30s-2 min) at mile pace or faster, with full recovery. Improves running economy, speed, and neuromuscular power."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répétitions courtes (~30s-2 min) à allure 1500m-1 mile ou plus rapide, avec récupération complète. Améliore l'économie de course, la vitesse, la puissance neuromusculaire."
          }
        }
      }
    },
    "glossary.daniels.r.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daniels-R — Repetition"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daniels-R — Répétitions rapides"
          }
        }
      }
    },
    "glossary.daniels.t.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lactate threshold pace, ~88-92% HRmax. Sustained ~20-40 min at this pace, in continuous blocks or 6-12 min cruise intervals."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allure au seuil lactique, ~88-92% FC max. Tenable ~20-40 min, soit en bloc continu, soit en intervalles 6-12 min (cruise intervals)."
          }
        }
      }
    },
    "glossary.daniels.t.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daniels-T — Threshold (tempo)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daniels-T — Seuil (tempo)"
          }
        }
      }
    },
    "glossary.dislocation.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pass an elastic band over your head then behind your back, arms straight, and return. Shoulder mobility exercise. No actual dislocation despite the name."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer une bande élastique au-dessus de la tête puis derrière le dos, bras tendus, et revenir. Exercice de mobilité des épaules. Pas de luxation réelle malgré le nom."
          }
        }
      }
    },
    "glossary.dislocation.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulder dislocation (band)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulder dislocation (élastique)"
          }
        }
      }
    },
    "glossary.drill.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exercise that isolates ONE technical aspect of a sport movement. Not a 'real' set — perform slowly to feel and correct a specific phase. Example in swimming: 'catch-up drill' = one arm extended forward waits until the other arm completes its full stroke and touches it, then the cycle restarts. Isolates glide and coordination."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exercice qui isole UN aspect technique d'un geste sportif. Pas une 'vraie' série — on fait lentement pour sentir et corriger une phase précise. Exemple en natation : drill 'rattrapé' = un bras tendu devant attend que l'autre bras fasse le cycle complet et vienne le toucher, puis ce dernier redémarre. Isole la glisse et la coordination."
          }
        }
      }
    },
    "glossary.drill.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drill — Technique isolation exercise"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drill (éducatif) — Exercice technique d'isolation"
          }
        }
      }
    },
    "glossary.emom.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the start of each minute, complete the prescribed work (e.g. 5 thrusters). The remaining time in the minute is your rest. Repeat for N minutes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au début de chaque minute, tu fais le travail prescrit (ex. 5 thrusters). Le reste de la minute est ta récupération. Tu enchaînes N minutes."
          }
        }
      }
    },
    "glossary.emom.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EMOM — Every Minute On the Minute"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EMOM — Chaque minute, à la minute"
          }
        }
      }
    },
    "glossary.en.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swimming aerobic zones: EN1 = easy (warm-up, recovery), EN2 = steady aerobic (most training volume), EN3 = upper aerobic (sustained, just below threshold)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zones aérobie en natation : EN1 = facile (échauffement, récup), EN2 = aérobie soutenue (la majorité du volume), EN3 = aérobie haute (juste sous le seuil)."
          }
        }
      }
    },
    "glossary.en.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EN1 / EN2 / EN3 — Swim endurance zones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EN1 / EN2 / EN3 — Zones d'endurance natation"
          }
        }
      }
    },
    "glossary.entry.detail.sports" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used in"
          }
        },
        "fr" : {
          "stringUnit" : {
