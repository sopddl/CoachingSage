          }
        }
      }
    },
    "glossary.fartlek.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swedish for « speed play ». Unstructured workout alternating fast and slow segments based on feel, terrain or landmarks, rather than precise paces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suédois pour « jeu d'allures ». Séance non structurée alternant des segments rapides et lents au feeling, selon le terrain ou des repères, plutôt qu'à une allure précise."
          }
        }
      }
    },
    "glossary.fartlek.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fartlek — Speed play"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fartlek — Jeu d'allures"
          }
        }
      }
    },
    "glossary.football.rsa.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ability to repeat several short sprints with little recovery."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capacité à enchaîner plusieurs sprints courts avec peu de récupération."
          }
        }
      }
    },
    "glossary.football.rsa.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA — Repeated Sprint Ability"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA — Repeated Sprint Ability"
          }
        }
      }
    },
    "glossary.football.sprintrepete.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A series of short sprints (5-10s) with short recoveries, typical in football."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Série de sprints courts (5-10s) entrecoupés de récupérations courtes, typique du foot."
          }
        }
      }
    },
    "glossary.football.sprintrepete.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeated sprints"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprints répétés"
          }
        }
      }
    },
    "glossary.football.transition.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The moment a team switches from defending to attacking (or vice versa) after winning or losing the ball."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moment où l'équipe passe de la défense à l'attaque (ou inverse) après récupération ou perte."
          }
        }
      }
    },
    "glossary.football.transition.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
