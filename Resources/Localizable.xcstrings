            "state" : "translated",
            "value" : "Micro-interval"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Micro-intervalle"
          }
        }
      }
    },
    "glossary.hiit.workrest.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratio of work time to rest time: 30s/30s means a 1:1 ratio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapport temps d'effort sur temps de récup : 30s/30s = ratio 1:1."
          }
        }
      }
    },
    "glossary.hiit.workrest.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work-rest ratio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratio effort/récup"
          }
        }
      }
    },
    "glossary.hiking.denivele.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total meters climbed on the route: 500m D+ means 500m climbed in total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somme des montées du parcours, en mètres : 500m D+ = 500m grimpés au total."
          }
        }
      }
    },
    "glossary.hiking.denivele.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total ascent"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dénivelé positif (D+)"
          }
        }
      }
    },
    "glossary.hiking.elevation.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altitude difference between the lowest and highest point of the route."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Différence d'altitude entre le point le plus bas et le point le plus haut du parcours."
          }
        }
      }
    },
    "glossary.hiking.elevation.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
