    "glossary.zones.definition": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart-rate zones based on your max HR. Z1-Z2 = easy aerobic (chat possible), Z3 = tempo (short sentences), Z4 = threshold (1-2 words), Z5 = maximal (no talking)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonas de frecuencia cardiaca calculadas sobre tu FC máx. Z1-Z2 = aeróbico fácil (puedes hablar), Z3 = tempo (frases cortas), Z4 = umbral (1-2 palabras), Z5 = máximo (hablar imposible)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zones de fréquence cardiaque calculées sur ta FC max. Z1-Z2 = aérobie facile (tu peux discuter), Z3 = tempo (phrases courtes), Z4 = seuil (1-2 mots), Z5 = maximal (parler impossible)."
          }
        }
      }
    },
    "glossary.zones.title": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HR zones (Z1-Z5)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonas de FC (Z1-Z5)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zones FC (Z1-Z5)"
          }
        }
      }
    },
