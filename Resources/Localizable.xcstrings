          }
        }
      }
    },
    "glossary.ftp.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Power (watts) you can hold for ~1 hour on the bike. FTP-Z1 to Z7 are training zones derived from it. Z2 = endurance, Z4 = threshold, Z5+ = VO2max and above."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puissance (watts) tenable ~1h sur le vélo. FTP-Z1 à Z7 sont les zones d'entraînement dérivées. Z2 = endurance, Z4 = seuil, Z5+ = VO2max et plus."
          }
        }
      }
    },
    "glossary.ftp.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP — Functional Threshold Power (cycling)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTP — Seuil fonctionnel (vélo)"
          }
        }
      }
    },
    "glossary.hiit.epoc.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excess oxygen consumption after exercise: the body keeps burning calories for a while afterward."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surconsommation d'oxygène après l'effort : le corps continue de brûler des calories un moment après."
          }
        }
      }
    },
    "glossary.hiit.epoc.title" : {
      "extractionState" : "manual",
      "localizations" : {
