          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sweet-Spot (vélo)"
          }
        }
      }
    },
    "glossary.tabata.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 rounds of 20 sec all-out effort + 10 sec rest = 4 minutes total. Originally designed for VO2max + anaerobic capacity research."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 répétitions de 20 sec à fond + 10 sec de repos = 4 min au total. Protocole d'origine japonaise pour cibler VO2max + capacité anaérobie."
          }
        }
      }
    },
