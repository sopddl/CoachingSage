      }
    },
    "onboarding.howItWorks.deadline.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A race, a tournament, a season opener? Léon paces your plan to peak on the right day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Una carrera, un torneo, una temporada que arranca? Léon ajusta tu plan para que estés listo el día clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une course, un tournoi, une saison qui démarre ? Léon cale ton plan pour être prêt·e le jour J."
          }
        }
      }
    },
    "onboarding.howItWorks.deadline.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a target date"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una fecha objetivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec une date cible"
          }
        }
      }
    },
    "onboarding.howItWorks.pauseRecovery.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sick, on holiday, swamped? No problem. Léon detects your pause and eases you back in when you return — no overload, your body re-acclimates gradually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Enfermo, de vacaciones, desbordado? No pasa nada. Léon detecta tu pausa y te reincorpora con suavidad cuando vuelves: sin sobrecarga, tu cuerpo se readapta progresivamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Malade, en vacances, débordé·e ? Aucun souci. Léon détecte ta pause et reprend en douceur quand tu reviens — pas de surcharge, ton corps se réhabitue progressivement."
          }
        }
      }
    },
    "onboarding.howItWorks.pauseRecovery.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause & restart"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa y reanudación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause & reprise"
          }
        }
      }
    },
    "onboarding.howItWorks.routine.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No fixed date? A 3-month routine that renews itself based on your progress, no end in sight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No tienes una fecha concreta? Una rutina de 3 meses que se renueva según tus progresos, sin fin programado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de date précise ? Une routine de 3 mois qui se renouvelle selon tes progrès, sans fin programmée."
          }
        }
      }
    },
    "onboarding.howItWorks.routine.title": {
