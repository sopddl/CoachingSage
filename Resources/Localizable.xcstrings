          }
        }
      }
    },
    "glossary.tempo.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustained running, cycling or rowing pace — comfortable but firm. Between easy aerobic and lactate threshold (RPE 6-7)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allure de course, vélo ou rameur soutenue — exigeante mais tenable. Entre l'aérobie facile et le seuil lactique (RPE 6-7)."
