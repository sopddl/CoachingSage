            "value" : "Glossaire"
          }
        }
      }
    },
    "glossary.intervals.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training method alternating hard efforts with active or passive recovery. Builds aerobic and anaerobic capacity faster than steady-state work."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Méthode d'entraînement alternant efforts soutenus et récupération active ou passive. Développe les capacités aérobie et anaérobie plus vite qu'un effort continu."
          }
        }
      }
    },
    "glossary.intervals.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervals — Effort/recovery blocks"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalles — Blocs effort/récupération"
          }
        }
      }
    },
    "glossary.lactate.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substance produced by muscles during intense effort. Above the lactate threshold it accumulates faster than the body can clear it, causing burn and forcing slowdown."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substance produite par les muscles à effort intense. Au-dessus du seuil lactique, il s'accumule plus vite que le corps ne peut l'éliminer, ce qui provoque la sensation de brûlure et force à ralentir."
          }
        }
      }
    },
    "glossary.lactate.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lactate — Effort byproduct"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lactate — Sous-produit de l'effort"
          }
        }
      }
    },
    "glossary.plank.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Static core hold on forearms (or extended arms) and toes, body in a straight line from shoulders to heels. Side plank variant: side-lying with one forearm on the floor and feet stacked — works the obliques. Hold without letting hips drop."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gainage statique sur les avant-bras (ou bras tendus) et la pointe des pieds, corps en ligne droite épaules-talons. Variante latérale (side plank) : sur le côté, un seul avant-bras au sol, pieds empilés — travaille les obliques. Tenir sans laisser tomber le bassin."
          }
        }
      }
    },
    "glossary.plank.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plank — Isometric core hold"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plank (planche) — Gainage isométrique"
          }
        }
      }
    },
    "glossary.plyometric.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exercises involving rapid stretch then powerful contraction (jumps, bounds, hops). Develop power, neuromuscular speed and reactive strength."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exercices avec étirement rapide puis contraction puissante (sauts, bondissements). Développent la puissance, la vitesse neuromusculaire et la force réactive."
          }
        }
      }
    },
    "glossary.plyometric.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plyometric — Explosive jumps"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliométrique — Sauts explosifs"
          }
        }
      }
    },
    "glossary.pushoff.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powerful push from the pool wall after a turn (~5-8m underwater). Free distance — boosts overall lap time but skews lap-by-lap pace measurements."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussée puissante du mur après un virage (~5-8m sous l'eau). Distance gratuite — améliore le temps global au tour mais fausse la mesure du pace lap par lap."
          }
        }
      }
    },
    "glossary.pushoff.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-off — Wall kick (swimming)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-off — Poussée au mur (natation)"
          }
        }
      }
    },
    "glossary.race.pace.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pace you'd hold for that distance in a race. 5K pace ≈ Daniels-I/T, 10K pace ≈ Daniels-T. Used as a concrete intensity target."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'allure tenable sur cette distance en course. Allure 5K ≈ Daniels-I/T, allure 10K ≈ Daniels-T. Sert de cible d'intensité concrète."
          }
        }
      }
    },
    "glossary.race.pace.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Race pace (5K, 10K…)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allure course (5K, 10K…)"
          }
        }
      }
    },
    "glossary.rampup.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progressively increase load over 2-3 sets before your working set. Primes the nervous system and reduces injury risk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monter progressivement en charge sur 2-3 séries avant la série de travail. Prépare le système nerveux et limite le risque de blessure."
          }
        }
      }
    },
    "glossary.rampup.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ramp up — Progressive loading"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ramp up — Montée en charge"
          }
        }
      }
    },
    "glossary.reps.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reps = abbreviation for repetitions. '10 reps' = 10 movement repetitions in a single set."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reps = abréviation de répétitions. '10 reps' = 10 répétitions du mouvement dans une seule série."
          }
        }
      }
    },
    "glossary.reps.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reps — Repetitions"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reps — Répétitions"
          }
        }
      }
    },
    "glossary.rir.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reps in reserve = how many reps you could still do before total failure. RIR 2 = stop 2 reps before you can't do any more."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reps en réserve = combien de répétitions tu pourrais encore faire avant l'échec. RIR 2 = arrête-toi 2 répétitions avant de ne plus pouvoir."
          }
        }
      }
    },
    "glossary.rir.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RIR — Reps In Reserve"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RIR — Reps In Reserve"
          }
        }
      }
    },
    "glossary.rpe.definition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borg 1-10 scale: how hard a session feels. 1 = very easy, 5 = moderate, 10 = maximal sprint. Subjective but reliable to gauge intensity without sensors."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échelle de Borg 1-10 : à quel point la séance est dure. 1 = très facile, 5 = modéré, 10 = sprint maximal. Subjectif mais fiable pour jauger l'intensité sans capteur."
          }
        }
      }
    },
    "glossary.rpe.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE — Perceived effort"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE — Effort ressenti"
          }
        }
      }
    },
    "glossary.scapular.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scapula = shoulder blade. Scapular mobility = moving shoulder blades independently from arms (up/down, front/back, rotation). Essential for healthy shoulders."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scapula = omoplate. Mobilité scapulaire = bouger les omoplates indépendamment des bras (haut/bas, avant/arrière, rotation). Essentiel pour des épaules saines."
          }
        }
      }
    },
    "glossary.scapular.title" : {
      "extractionState" : "manual",
      "localizations" : {
