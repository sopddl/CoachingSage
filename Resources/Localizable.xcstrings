    "onboarding.howItWorks.deadline.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A race, a tournament, a season opener? Léon paces your plan to peak on the right day."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une course, un tournoi, une saison qui démarre ? Léon cale ton plan pour être prêt·e le jour J."
          }
        }
      }
    },
    "onboarding.howItWorks.deadline.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With a target date"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec une date cible"
          }
        }
      }
    },
    "onboarding.howItWorks.pauseRecovery.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sick, on holiday, swamped? No problem. Léon detects your pause and eases you back in when you return — no overload, your body re-acclimates gradually."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malade, en vacances, débordé·e ? Aucun souci. Léon détecte ta pause et reprend en douceur quand tu reviens — pas de surcharge, ton corps se réhabitue progressivement."
          }
        }
      }
    },
    "onboarding.howItWorks.pauseRecovery.title" : {
