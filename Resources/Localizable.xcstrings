    "onboarding.parq.q1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you experience chest pain or pain during exertion?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sientes dolor en el pecho o al hacer esfuerzo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ressentez-vous des douleurs à la poitrine ou à l'effort ?"
          }
        }
      }
    },
    "onboarding.parq.q2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you experience dizziness or loss of balance?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tienes mareos o pierdes el equilibrio?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous des étourdissements ou perdez-vous l'équilibre ?"
          }
        }
      }
    },
    "onboarding.parq.q3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you have a joint problem aggravated by physical activity?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Padeces algún problema articular que empeore con la actividad física?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souffrez-vous d'un problème articulaire aggravé par l'activité physique ?"
          }
        }
      }
    },
    "onboarding.parq.q4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you taking medication for blood pressure or heart conditions?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tomas medicación para la tensión arterial o el corazón?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez-vous des médicaments pour la tension artérielle ou le cœur ?"
          }
        }
      }
    },
    "onboarding.parq.q5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you know any other reason why you should not exercise?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Conoces alguna otra razón por la que no deberías hacer ejercicio?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connaissez-vous une autre raison pour laquelle vous ne devriez pas faire d'exercice ?"
          }
        }
      }
    },
    "onboarding.parq.title": {
      "localizations": {
