    "glossary.yoga.drishti.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixed gaze point chosen to steady balance and focus inside a posture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Punto de mirada fijo elegido para estabilizar el equilibrio y la atención en una postura."
          }
