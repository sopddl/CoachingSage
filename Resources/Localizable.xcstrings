    "onboarding.sport.hiit.tooltip.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HIIT (High Intensity Interval Training): short, high-intensity intervals alternating with brief recovery. Typical sessions last 15-30 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HIIT (High Intensity Interval Training): entrenamiento por intervalos cortos e intensos, alternando esfuerzos máximos y recuperaciones breves. Sesiones típicas de 15 a 30 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HIIT (High Intensity Interval Training) : entraînement par intervalles courts et intenses, alternant efforts maximums et récupération courte. Sessions typiques de 15 à 30 minutes."
          }
        }
      }
    },
    "onboarding.sport.hiit.tooltip.title": {
