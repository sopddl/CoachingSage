          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créer un nouveau programme"
          }
        }
      }
    },
    "dashboard.toolbar.create.label" : {
      "localizations" : {
        "en" : {
