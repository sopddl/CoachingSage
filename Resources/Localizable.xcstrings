    "onboarding.howItWorks.adaptation.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Léon reads your Apple Health workouts every week (Apple Watch, Strava, Garmin and other connected apps) and adapts your upcoming sessions to what you really did — volume, intensity, recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Léon lee cada semana tus sesiones de Apple Salud (Apple Watch, Strava, Garmin y otras apps conectadas) y adapta tus próximas sesiones a lo que realmente hiciste: volumen, intensidad, recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Léon lit chaque semaine tes séances Apple Santé (Apple Watch, Strava, Garmin et autres apps reliées) et adapte tes prochaines séances à ce que tu as vraiment fait — volume, intensité, récup."
          }
        }
      }
    },
    "onboarding.howItWorks.adaptation.title": {
      "localizations": {
