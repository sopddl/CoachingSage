    "coaching.dosage.charge.band": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Band: pick a tension where the last 2 reps are hard, with clean form."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Banda: elige una tensión donde las 2 últimas repeticiones sean difíciles, sin trampas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Élastique : choisis une tension où les 2 dernières reps sont dures, sans tricher."
          }
        }
      }
    },
    "coaching.dosage.charge.bodyweight": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodyweight: the last 2 reps should stay hard. Too easy? Add reps or slow the lowering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peso corporal: las 2 últimas reps deben seguir difíciles. ¿Muy fácil? Añade reps o baja más lento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poids du corps : les 2 dernières reps doivent rester dures. Trop facile ? Ajoute des reps ou ralentis la descente."
          }
        }
      }
    },
    "coaching.dosage.charge.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load: heavy enough that the last 2 reps are hard, with clean form."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga: suficiente para que las 2 últimas repeticiones sean difíciles, sin trampas."
