    "glossary.tennis.topspin.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forward spin: the ball dips and bounces high."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efecto liftado hacia delante: la bola cae y bota alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effet lifté vers l'avant : la balle plonge et rebondit haut."
          }
        }
      }
    },
    "glossary.tennis.topspin.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topspin"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift (topspin)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift (topspin)"
          }
        }
      }
    },
    "glossary.thoracic.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ability to move the thoracic spine (between shoulders and pelvis). Key mobility for fluid upper-body movement and healthy shoulders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacidad de mover la columna dorsal (entre los hombros y la pelvis). Movilidad esencial para movimientos fluidos del tren superior y unos hombros sanos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacité à bouger la colonne dorsale (entre épaules et bassin). Mobilité essentielle pour des mouvements fluides du haut du corps et des épaules saines."
          }
        }
      }
    },
    "glossary.thoracic.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoracic mobility"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movilidad torácica"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobilité thoracique"
          }
        }
      }
    },
    "glossary.threshold.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensity at the edge of what you can sustain about an hour. Above it, lactate accumulates fast and effort becomes maximal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensidad al límite de lo que puedes sostener alrededor de una hora. Por encima, el lactato se acumula rápido y el esfuerzo se vuelve máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensité à la limite de ce que tu peux tenir environ une heure. Au-dessus, le lactate s'accumule rapidement et l'effort devient maximal."
          }
        }
      }
    },
    "glossary.threshold.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Threshold — Lactate threshold"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbral láctico"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuil lactique"
          }
        }
      }
    },
    "glossary.triathlon.brick.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workout chaining two disciplines back-to-back, typically bike then run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión que encadena dos disciplinas, típicamente bici y luego carrera a pie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séance qui enchaîne deux disciplines, typiquement vélo puis course à pied."
          }
        }
      }
    },
    "glossary.triathlon.brick.title": {
