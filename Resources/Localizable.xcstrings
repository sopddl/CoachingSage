    "onboarding.thirdparty.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachingSage will use Apple Health to read your workouts. You'll grant Health access in the next step. If your sport apps don't send data to Health, we won't be able to see them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachingSage usará Apple Salud para ver tus sesiones. Darás el permiso de Salud en el siguiente paso. Si tus apps deportivas no envían sus sesiones a Salud, no podremos verlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CoachingSage utilisera Apple Santé pour voir tes séances. Tu donneras l'autorisation Santé à l'étape suivante. Si tes apps sport n'envoient pas leurs séances à Santé, on ne pourra pas les voir."
          }
        }
      }
    },
