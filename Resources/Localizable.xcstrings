            "value": "Slice"
          }
        }
      }
    },
    "glossary.tennis.splitstep.definition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small hop in place just before the opponent hits, to react quickly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeño salto en el sitio justo antes del golpe del rival para poder salir rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit saut sur place juste avant la frappe adverse pour pouvoir partir vite."
          }
        }
      }
    },
    "glossary.tennis.splitstep.title": {
