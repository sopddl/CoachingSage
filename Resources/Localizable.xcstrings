          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scapulaire — Omoplate"
          }
        }
      }
    },
    "glossary.strides.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short controlled accelerations (~20-30 sec, 80-100m) on the flat or slight downhill. Improves form and leg turnover without taxing energy systems."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accélérations courtes contrôlées (~20-30 sec, 80-100m) sur le plat ou légère descente. Améliore la foulée et la cadence sans fatiguer."
          }
        }
      }
    },
    "glossary.strides.title" : {
      "extractionState" : "manual",
      "localizations" : {
